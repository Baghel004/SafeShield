# Copy to .env and fill in. Never commit .env.

ENV=dev
DEBUG=true

DATABASE_URL=postgresql+psycopg://safeshield:safeshield@localhost:5432/safeshield
TEST_DATABASE_URL=postgresql+psycopg://safeshield:safeshield@localhost:5432/safeshield_test
REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Phase 2+
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
