# Copy to .env and fill in.  .env is gitignored and must never be committed.
#
# Every secret the application uses is listed here. Nothing sensitive is
# hardcoded: the defaults in app/config.py exist only so the project runs
# locally, and ENV=prod refuses to start if any of them are still in place.
#
# For deployment, set these as environment variables / platform secrets
# (GitHub Actions secrets, Fly.io secrets, etc.) rather than shipping a file.

# ---------------------------------------------------------------- environment
ENV=dev                  # dev | test | prod
DEBUG=true               # must be false when ENV=prod

# ------------------------------------------------------------------- database
# Local (docker compose). For Neon/RDS use the provider's URL and keep sslmode.
DATABASE_URL=postgresql+psycopg://safeshield:safeshield@localhost:5432/safeshield
TEST_DATABASE_URL=postgresql+psycopg://safeshield:safeshield@localhost:5432/safeshield_test

# Host port for the compose Postgres. Change it if something already holds 5432
# -- a local Postgres will otherwise shadow the container silently.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
# Set false for the single-process deployment (one web instance, no worker, no
# Redis): rate limiting stays in memory and ingestion runs in the API process.
# See docs/DEPLOY-FREE.md. Leave true for local dev and the scalable deployment.
REDIS_ENABLED=true

# ----------------------------------------------------------------------- auth
# REQUIRED in production. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cookie flags for the refresh token. COOKIE_SECURE must be true in production
# (HTTPS only) or the token is transmitted in the clear.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ----------------------------------------------------------------------- cors
# Comma-separated. Must be https and must not be "*" in production, because
# credentials are allowed.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --------------------------------------------------------------------- openai
# REQUIRED for real embeddings and answer generation. Without it the app falls
# back to deterministic fake embeddings (development only).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# ------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_CHAT=20/hour

# -------------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=400
UPLOAD_DIR=uploads

# ----------------------------------------------------------------------- demo
DEMO_EMAIL=demo@safeshield.app
