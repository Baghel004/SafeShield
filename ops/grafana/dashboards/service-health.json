{
  "uid": "safeshield-service",
  "title": "SafeShield — service health",
  "description": "Rate, errors, duration and saturation for the API, plus the dependencies that take it down. This is the dashboard you open when someone says the site is slow.",
  "tags": ["safeshield"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Traffic and errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "sum(rate(safeshield_http_requests_total[5m]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests returning 5xx. Alerts fire above 5%.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(safeshield_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(safeshield_http_requests_total[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "Chat excluded — a grounded answer legitimately takes seconds and would swamp everything else.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(safeshield_http_request_duration_seconds_bucket{route!~\"/api/chat.*\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "In flight",
      "description": "Concurrent requests. Sustained growth means work is arriving faster than it completes.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(safeshield_http_requests_in_flight)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "sum(up)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "green", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Rate limited / min",
      "description": "429s. A steady trickle is the limiter working; a spike is someone scripting.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        { "expr": "sum(rate(safeshield_http_requests_total{status=\"4xx\"}[5m])) * 60", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (route) (rate(safeshield_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum by (status) (rate(safeshield_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "p50 / p95 / p99. The gap between them is the story: a wide gap means a slow minority, which is what users report.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(safeshield_http_request_duration_seconds_bucket{route!~\"/api/chat.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(safeshield_http_request_duration_seconds_bucket{route!~\"/api/chat.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(safeshield_http_request_duration_seconds_bucket{route!~\"/api/chat.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "row",
      "title": "Dependencies",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "type": "timeseries",
      "title": "Postgres connections",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count)", "legendFormat": "in use", "refId": "A" },
        { "expr": "max(pg_settings_max_connections)", "legendFormat": "max", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Redis memory and clients",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "memory", "refId": "A" },
        { "expr": "redis_connected_clients", "legendFormat": "clients", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "memory" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Database rows read/written",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_fetched[5m]))", "legendFormat": "fetched", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted[5m]))", "legendFormat": "inserted", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      }
    }
  ]
}
