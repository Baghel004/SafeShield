# Where the API lives.
#
# Leave empty in development: Vite proxies /api to the backend so the browser
# sees a single origin, which is what lets the httpOnly refresh cookie come
# back on reload.
#
# In production set it to the deployed API origin, e.g.
#   VITE_API_BASE_URL=https://api.safeshield.example
# and add that origin to CORS_ORIGINS on the backend, or the browser will block
# every request before it is sent.
VITE_API_BASE_URL=
