# Environment for docker compose.
#
# Copy to `.env` in THIS directory -- the repository root, beside
# docker-compose.yml. Compose only reads a .env sitting next to the compose
# file, so `backend/.env` is invisible to it no matter what is in there.
#
# Getting this wrong is quiet rather than loud: outside production a missing
# OPENAI_API_KEY makes the app fall back to deterministic fake embeddings, so
# the corpus indexes cleanly, every document reports `ready`, and retrieval
# returns noise. Nothing raises. With ENV=prod the app refuses to start
# instead, which is the whole reason that check exists.
#
# `backend/.env` is still the right place when running the API directly with
# `python run.py`. The two files serve different launchers.

# Required for real embeddings and answers.
OPENAI_API_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Move the published Postgres port if a local install already holds 5432 --
# it will otherwise shadow the container silently and you will query the
# wrong database.
# POSTGRES_PORT=5433

# Monitoring
# GRAFANA_PORT=3001
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin
# PROMETHEUS_PORT=9090
